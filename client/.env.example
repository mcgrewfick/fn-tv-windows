# ============================================
# 飞牛影视客户端 环境变量示例
# 复制本文件为 .env，填入实际值
# ============================================

# authx 签名常量（逆向自飞牛影视公开前端 JS）
# 获取方式：抓取/查看飞牛影视网页前端的 JS 资源，找到 authx 签名算法中的 secret 与 api_key
FNTOS_SECRET=
FNTOS_API_KEY=

# 飞牛影视服务器地址（可选，登录界面也可直接填写）
# 格式：http://<NAS-IP>:5666
FNTOS_BASE=
