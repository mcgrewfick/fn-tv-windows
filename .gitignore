# ===== 依赖与构建产物 =====
node_modules/
dist/
out/
build/
*.asar
asar_check/

# ===== 逆向参考素材（飞牛官方前端打包资源，非本项目源码）=====
# probe/ 下是从飞牛影视网页下载的 JS/CSS/HTML 资源，
# 其中部分文件包含逆向所得的签名 secret / api_key 等常量，
# 以及个别含明文账号密码的临时脚本，故整体不纳入版本库。
probe/*.js
probe/*.css
probe/*.html
probe/*.py

# ===== 打包依赖的本地 mpv 二进制（体积大，非源码）=====
vendor/

# ===== 运行时生成 =====
shot_out.txt
*.log

# ===== 敏感信息 / 本地环境变量 =====
.env
.env.local
.env.*.local

# ===== 系统与编辑器 =====
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ===== 项目私有数据（WorkBuddy 工作记忆，不应公开）=====
.workbuddy/

